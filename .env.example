# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trading_duels?schema=public"

# JWT / Auth
JWT_SECRET="change-me-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"
NEXTAUTH_SECRET="change-me-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# API
API_PORT=3001
API_URL="http://localhost:3001"
CORS_ORIGIN="http://localhost:3000"

# Frontend (baked into Next.js at build time — set on Railway WEB service)
# Public API origin only (no /api path). Socket.IO uses the same origin + /socket.io
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Optional alias; socket client prefers NEXT_PUBLIC_API_URL
NEXT_PUBLIC_WS_URL="http://localhost:3001"

# Production Railway example:
# CORS_ORIGIN="https://web-production-38a05.up.railway.app"
# NEXT_PUBLIC_API_URL="https://trading-duels-production.up.railway.app"

# Twelve Data (precios reales)
# https://twelvedata.com/register → https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=
